# Shared, external docker network both services join.
NETWORK=

# Elasticsearch and Kibana image tag (same for both).
ES_TAG=9.5.3

# Restart policy. Unset defaults to "unless-stopped".
RESTART=

# Password of the built-in `elastic` superuser.
ES_PASS=

# Password the `setup` one-shot assigns to the built-in `kibana_system` user,
# which Kibana uses to talk to Elasticsearch. It is embedded in a JSON body,
# so avoid `"` and `\` in it.
KIBANA_PASSWORD=

# At least 32 characters; must not change once set (e.g. openssl rand -hex 32).
KIBANA_ENCRYPTION_KEY=

DOMAIN=
# Extra network alias for elasticsearch on NETWORK.
FULL_ES_HOSTNAME=

# Container memory limits. Leave ES_JAVA_OPTS empty to let Elasticsearch size
# its heap from ES_MEM_LIMIT (about half of it); set e.g. "-Xms2g -Xmx2g" to
# pin it explicitly.
ES_MEM_LIMIT=4g
ES_JAVA_OPTS=
KIBANA_MEM_LIMIT=1g

TIMEZONE=UTC

# Only needed when also deploying with -f compose.public.yaml: hostname Kibana
# is served at through proxy-ssl, and the acme-companion contact address.
KIBANA_DOMAIN=
LETSENCRYPT_EMAIL=
