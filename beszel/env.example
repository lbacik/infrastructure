# Shared, external docker network beszel joins.
NETWORK=

# Restart policy. Unset defaults to "unless-stopped".
RESTART=

# nginx-proxy routing + acme-companion. Full hostname the hub is served at;
# also used to build APP_URL (https://<VIRTUAL_HOST>).
VIRTUAL_HOST=

# acme-companion. Leave empty on hosts without a public name.
LETSENCRYPT_EMAIL=

# Hub port. Always bound to 127.0.0.1 (hardcoded in compose.yaml) for the
# local beszel-agent to reach it - see AGENT_TOKEN/AGENT_KEY below.
PORT=

# Only needed when also deploying with -f compose.override.yaml: binds the
# hub's UI to an additional, LAN-reachable address/port pair.
LAN_HOST_IP=

# Credentials for the beszel-agent service, which monitors the host beszel
# itself runs on. Generate both from the hub after it's up:
#   AGENT_KEY   - hub's own SSH public key: GET /api/beszel/info (auth'd)
#   AGENT_TOKEN - a permanent universal token:
#                 GET /api/beszel/universal-token?enable=1&permanent=1 (auth'd, non-superuser)
# Leave both unset to run the hub without a local agent.
AGENT_TOKEN=
AGENT_KEY=
