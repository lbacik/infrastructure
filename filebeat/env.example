# Shared, external docker network Elasticsearch is reachable on.
NETWORK=

# Restart policy. Unset defaults to "unless-stopped".
RESTART=

# Filebeat image tag. Keep it equal to the elastic project's ES_TAG
# (Filebeat must not be newer than Elasticsearch).
FILEBEAT_TAG=9.5.3

# Reported as `host.name` on every event.
HOST_NAME=

# Elasticsearch URL. The service name works when both projects share NETWORK.
ES_HOST=http://elasticsearch:9200

# API key in the "id:api_key" form (the `id` and `api_key` fields of the
# response, joined with a colon - NOT the base64 `encoded` field). Create it
# as the `elastic` user, e.g. in Kibana > Dev Tools:
#
#   POST /_security/api_key
#   {
#     "name": "filebeat-<host>",
#     "role_descriptors": {
#       "filebeat_docker": {
#         "cluster": ["monitor", "read_ilm", "manage_ilm",
#                     "manage_index_templates", "read_pipeline",
#                     "manage_ingest_pipelines"],
#         "indices": [{
#           "names": ["filebeat-docker"],
#           "privileges": ["create_doc", "create_index", "auto_configure",
#                          "view_index_metadata"]
#         }]
#       }
#     }
#   }
#
# The manage_* privileges and create_index let Filebeat install its index
# template and lifecycle policy, create the data stream, and install module
# ingest pipelines (for containers labelled co.elastic.logs/module) on start.
ES_API_KEY=

# How long logs are kept, counted from the daily rollover (ILM duration,
# e.g. 14d, 30d, 90d).
LOG_RETENTION=30d
