COMPOSE_PROJECT_NAME=

NETWORK=

VERSION=
PGV_VERSION=

PASSWORD=

PSQL_ALIAS=
PGV_ALIAS=

# Volume mount path inside the container. Default /var/lib/postgresql/data
# suits <=17; postgres 18+ images require /var/lib/postgresql.
PSQL_DATA_DIR=
PGV_DATA_DIR=

# Only needed when also deploying with -f compose.override.yaml (host port bindings)
HOST=
PORT=
PGV_PORT=

