# Shared, external docker network the registry joins.
NETWORK=

# Only used by the commented-out host port bindings in compose.yaml.
HOST_IP=

# Restart policy for both containers. Unset keeps the historical "no".
RESTART=

# nginx-proxy routing. An empty value keeps that service off the proxy.
REGISTRY_DOMAIN=
UI_DOMAIN=

# acme-companion. Set to the matching *_DOMAIN to request a certificate,
# leave empty on hosts without a public name.
REGISTRY_LETSENCRYPT_HOST=
UI_LETSENCRYPT_HOST=
LETSENCRYPT_EMAIL=

# Makes the UI send credentials to a registry that requires them.
# compose.public.yaml forces this on, so it only matters without that file.
REGISTRY_SECURED=

# Only needed when also deploying with -f compose.override.yaml (static IP/alias on the default network)
REGISTRY_IP=
REGISTRY_ALIAS=

# Only needed when also deploying with -f compose.public.yaml (htpasswd auth
# plus the nginx-proxy tuning an internet-facing registry needs).
# PROXY_VHOST_VOLUME defaults to proxy_nginx-vhost - override it only if the
# proxy-ssl project runs under a different -p on this host.
REGISTRY_USER=
REGISTRY_PASSWORD=
REGISTRY_HTTP_SECRET=
PROXY_VHOST_VOLUME=
