# Umami - privacy-friendly web analytics (https://umami.is). Served through
# proxy-ssl; the tracked sites load https://<VIRTUAL_HOST>/script.js.

# Shared, external docker network proxy-ssl watches and PostgreSQL is
# reachable on.
NETWORK=

# Pin to a tested release tag from ghcr.io/umami-software/umami (e.g. 3.4.0);
# do not use latest on deployed hosts.
UMAMI_VERSION=

# Restart policy. Unset defaults to "unless-stopped".
RESTART=

# Existing PostgreSQL service (the postgresql project). DB_HOST is its network
# alias on NETWORK; DB_PORT defaults to 5432. Create the role and database
# once, before the first start - Umami migrates the schema itself:
#   CREATE ROLE umami LOGIN PASSWORD '<DB_PASSWORD>';
#   CREATE DATABASE umami OWNER umami;
# DB_PASSWORD is embedded in a URL: keep it URL-safe (openssl rand -hex 24).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Session signing secret (openssl rand -hex 32). Changing it logs everyone out.
APP_SECRET=

# Encrypts stored 2FA secrets; 64 hex chars (openssl rand -hex 32). Must not
# change once users have enabled 2FA.
TWO_FACTOR_ENCRYPTION_KEY=

# nginx-proxy routing + acme-companion. Full hostname Umami is served at.
VIRTUAL_HOST=

# acme-companion contact address. Leave empty on hosts without a public name.
LETSENCRYPT_EMAIL=
