# Shared, external Docker network. Join the network used by proxy-ssl so the
# broker is reachable through nginx-proxy.
NETWORK=

# Pin the Broker image to a tested release tag; do not use latest in deployed
# hosts.
PACT_BROKER_VERSION=
RESTART=unless-stopped

# Existing PostgreSQL service. PACT_BROKER_DATABASE_HOST must be the PSQL_ALIAS
# configured for postgresql/compose.yaml on the same NETWORK. Use a dedicated
# database and role; PACT_BROKER_DATABASE_PASSWORD is a secret.
PACT_BROKER_DATABASE_HOST=
PACT_BROKER_DATABASE_PORT=5432
PACT_BROKER_DATABASE_NAME=pact_broker
PACT_BROKER_DATABASE_USERNAME=pact_broker
PACT_BROKER_DATABASE_PASSWORD=

# The externally reachable HTTPS URL. It must match PACT_BROKER_DOMAIN so API
# links are stable and consumers/providers can publish and verify contracts.
PACT_BROKER_DOMAIN=
PACT_BROKER_BASE_URL=
LETSENCRYPT_EMAIL=

# Basic-auth accounts: supply the read/write account to CI/CD and the read-only
# account to developers. Passwords are secrets; use distinct strong values.
PACT_BROKER_USERNAME=
PACT_BROKER_PASSWORD=
PACT_BROKER_READ_ONLY_USERNAME=
PACT_BROKER_READ_ONLY_PASSWORD=
