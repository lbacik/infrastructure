# LiteLLM - LLM gateway (https://docs.litellm.ai). Exposes an Anthropic
# Messages-compatible endpoint for Claude Code based agents and forwards
# requests to providers listed in images/litellm/config.yaml. Internal only:
# not published through proxy-ssl.

# Shared, external docker network the client containers are attached to.
NETWORK=

# Network alias clients use as the base URL host (http://<ALIAS>:4000).
# Unset defaults to "litellm".
ALIAS=

# Pin to a tested release tag from ghcr.io/berriai/litellm (e.g. v1.104.0);
# do not use latest on deployed hosts. Rebuild (`build`) after changing it
# or images/litellm/config.yaml. The Messages->Responses translation and
# its prompt-cache key derivation change between releases: re-run the
# client's cache probe after every bump.
LITELLM_VERSION=

# Restart policy. Unset defaults to "unless-stopped".
RESTART=

# Bearer token clients send (e.g. simple-coding-agent MODEL_API_KEY).
# Generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Meta Model API key used for the muse-spark models in
# images/litellm/config.yaml.
META_API_KEY=

# Log level (DEBUG, INFO, WARNING, ERROR). Unset defaults to INFO; DEBUG may
# log full request bodies.
LITELLM_LOG=

# compose.local.yaml only: loopback port published on the host.
# Unset defaults to 4000.
HOST_PORT=

# compose.db.yaml only: existing PostgreSQL service (the postgresql project)
# for spend logs, virtual keys and the Admin UI (/ui). DB_HOST is its network
# alias on NETWORK; DB_PORT defaults to 5432. Create the role and database
# once, before the first start - LiteLLM migrates the schema itself:
#   CREATE ROLE litellm LOGIN PASSWORD '<DB_PASSWORD>';
#   CREATE DATABASE litellm OWNER litellm;
# DB_PASSWORD is embedded in a URL: keep it URL-safe (openssl rand -hex 24).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# compose.db.yaml only: encrypts provider credentials stored in the database.
# Set once and never change it (stored credentials become unreadable).
# Generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=

# compose.db.yaml only: Admin UI login. UI_USERNAME defaults to "admin".
UI_USERNAME=
UI_PASSWORD=

# compose.lan.yaml only: host LAN address and port the proxy (API and Admin
# UI) is published on. LAN_PORT defaults to 4000.
LAN_IP=
LAN_PORT=
